# 火山引擎配置（必需）
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_NAME=doubao-seed-1-6-251015
VISION_MODEL_NAME=doubao-seedream-4-0-250828
VIDEO_MODEL_NAME=doubao-seedance-1-5-pro-251215

# JWT 配置（生产环境必需，必须设置强随机密钥）
# ⚠️ 安全警告：SECRET_KEY 用于JWT签名，必须使用强随机密钥
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 或使用：openssl rand -hex 32
# 生产环境请务必设置，且不要使用默认值或示例值
SECRET_KEY=your-secret-key-change-in-production

# 数据库配置
DATABASE_URL=sqlite:///./app.db

# API 配置
API_HOST=127.0.0.1
API_PORT=8000

# CORS 配置（多个域名用逗号分隔）
CORS_ORIGINS=*

# 文件上传配置
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif

# 短信服务配置（互亿无线）
# 是否启用短信服务（true/false），false时使用模拟发送
SMS_ENABLED=false
# APIID（用户中心【文本短信】-【验证码/通知短信】-【产品总览】查看）
SMS_ACCOUNT=your_sms_account
# APIKEY（用户中心【文本短信】-【验证码/通知短信】-【产品总览】查看）
SMS_PASSWORD=your_sms_password
# 短信模板ID（默认使用模板1：您的验证码是：【变量】。请不要把验证码泄露给其他人。）
SMS_TEMPLATE_ID=1
# 短信API地址（默认互亿无线）
SMS_API_URL=https://api.ihuyi.com/sms/Submit.json
# 短信余额阈值（条数），低于此值会发送告警邮件
# 例如：设置为100表示余额低于100条时发送告警
# 设置为0或留空则不检查余额（不推荐）
SMS_BALANCE_THRESHOLD=100

# 支付宝收款配置（用于个人收款码自动验证）
# 支付宝收款码图片URL（可以是本地路径或网络URL，如：/path/to/qrcode.png 或 https://example.com/qrcode.png）
# 如果使用套餐对应的收款码，请将收款码图片放在 backend/storage/qrcode/ 目录下
ALIPAY_QR_CODE_URL=
# 支付宝账号名称（用于显示，如：张三的支付宝）
ALIPAY_ACCOUNT_NAME=

# 支付宝自动验证配置（用于自动查询收款记录并确认支付）
# 获取方法：
# 1. 登录网页版支付宝（https://b.alipay.com）
# 2. 打开浏览器开发者工具（F12），在Console中输入 document.cookie 并回车
# 3. 复制完整的cookie字符串，粘贴到下面的 ALIPAY_COOKIE 配置中
# 注意：Cookie会过期，建议每周更新一次。如果发现自动验证失败，请重新获取Cookie。
ALIPAY_COOKIE=your_alipay_cookie_string_here
# 以下两个参数可以从cookie中自动提取，也可以手动配置
# ctoken（从cookie中的 ctoken=xxx 提取）
ALIPAY_CTOKEN=
# billUserId（从cookie中的 __TRACERT_COOKIE_bucUserId=xxx 提取）
ALIPAY_BILL_USER_ID=
# 轮询间隔（秒），默认30秒，建议不要设置太小以免触发支付宝风控
ALIPAY_POLLING_INTERVAL=30
# 轮询超时时间（秒），默认300秒（5分钟），超过此时间未匹配到订单则停止轮询
ALIPAY_POLLING_TIMEOUT=300

# 邮件告警配置（可选，用于API监控告警）
# 是否启用邮件告警（true/false），false时不会发送告警邮件
EMAIL_ENABLED=false
# SMTP服务器地址（QQ邮箱）
EMAIL_SMTP_HOST=smtp.qq.com
# SMTP端口（QQ邮箱推荐使用587，如果不可用可尝试465）
# 587端口使用TLS加密，需要设置EMAIL_USE_TLS=true
# 465端口使用SSL加密，需要设置EMAIL_USE_TLS=false
EMAIL_SMTP_PORT=587
# SMTP用户名（QQ邮箱地址，格式：QQ号@qq.com）
EMAIL_SMTP_USER=your_qq_number@qq.com
# SMTP授权码（不是QQ邮箱登录密码！）
# 获取方法：
# 1. 登录QQ邮箱（https://mail.qq.com）
# 2. 点击"设置" -> "账户"
# 3. 找到"POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务"
# 4. 开启"POP3/SMTP服务"或"IMAP/SMTP服务"
# 5. 点击"生成授权码"，按照提示发送短信验证
# 6. 复制生成的16位授权码（格式类似：abcdefghijklmnop）
# 详细步骤请参考 backend/MONITORING_SETUP.md
EMAIL_SMTP_PASSWORD=your_qq_authorization_code
# 发件人邮箱地址（通常与EMAIL_SMTP_USER相同）
EMAIL_FROM=your_qq_number@qq.com
# 收件人邮箱地址（支持多个，用逗号分隔，如：admin@example.com,admin2@example.com）
EMAIL_TO=your_email@example.com
# 是否使用TLS加密（true/false）
# 使用587端口时设置为true，使用465端口时设置为false
EMAIL_USE_TLS=true

# 监控告警配置
# 告警限流时间（小时），同一问题在此时间内最多发送1次告警，避免重复告警
# 例如：设置为1.0表示同一问题1小时内最多发送1次告警
ALERT_THROTTLE_HOURS=1.0
